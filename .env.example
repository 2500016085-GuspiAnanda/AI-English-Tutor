# Salin menjadi .env lalu isi nilainya. Jangan commit file .env.
DEEPSEEK_API_KEY=sk-isi-api-key-anda
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DATABASE_URL=postgresql://ai_tutor:password@localhost:5432/ai_english_tutor

# Opsional: suara tutor berekspresi (Gemini TTS). Kosong = suara bawaan browser.
# GEMINI_API_KEY=isi-api-key-gemini-dari-aistudio.google.com

# Django. Untuk lokal boleh dibiarkan; di produksi (Render) diisi lewat render.yaml / dashboard.
